{
  "manifest_version": 3,
  "name": "LanceUp",
  "version": "2.0.0",
  "description": "Bộ lọc và tính điểm cơ hội việc làm đa nền tảng cho Freelancer.com, Upwork và We Work Remotely",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Mở LanceUp Dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "storage",
    "cookies",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.freelancer.com/*",
    "https://*.upwork.com/*",
    "https://*.weworkremotely.com/*",
    "https://remoteok.com/*",
    "https://jobicy.com/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://*.upwork.com/*"],
      "js": ["content/upwork-content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "https://*.upwork.com/*",
        "https://*.freelancer.com/*"
      ]
    }
  ]
}
