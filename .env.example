# ==============================================================================
# LanceUp — Environment Variables Template
# Hướng dẫn: Sao chép file này thành '.env' và điền các giá trị thực tế của bạn.
# Lưu ý: File '.env' thực tế đã được đưa vào .gitignore để đảm bảo an toàn bảo mật.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TÍCH HỢP TRÍ TUỆ NHÂN TẠO (AI ASSISTANT - Tùy chọn)
# Sử dụng khi tích hợp tính năng tự động tóm tắt công việc hoặc hỗ trợ viết Proposal
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 2. XÁC THỰC SÀN VIỆC LÀM (Tùy chọn nếu cần nâng hạn mức gọi API)
# Mặc định LanceUp sử dụng session đăng nhập trên trình duyệt và API mở công khai.
# ------------------------------------------------------------------------------
FREELANCER_OAUTH_TOKEN=
UPWORK_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 3. THÔNG BÁO TỰ ĐỘNG (WEBHOOK ALERTS - Tùy chọn)
# Tự động gửi thông báo về điện thoại/nhóm khi phát hiện Job "ngon" có điểm số cao
# ------------------------------------------------------------------------------
# Ngưỡng điểm tối thiểu để kích hoạt thông báo (mặc định: 80/100 điểm)
MIN_ALERT_SCORE=80

# Webhook Discord hoặc Slack
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Bot Telegram cá nhân / nhóm
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH MÔI TRƯỜNG PHÁT TRIỂN (DEVELOPMENT / DEBUG)
# ------------------------------------------------------------------------------
# development | production
APP_ENV=development

# Bật dữ liệu mẫu ngoại tuyến khi không có mạng (true / false)
ENABLE_OFFLINE_FIXTURES=false

# Bật log chi tiết cho các tiến trình mạng trong console (true / false)
DEBUG_LOGS=false
